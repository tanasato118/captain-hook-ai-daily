# このファイルをコピーして .env にリネームし、各値を設定してください。
# .env は git に含めないでください（.gitignore 済み）。

# --- X API ---
# 取得元: https://developer.x.com → Project & Apps → Keys and tokens → Bearer Token
# 形状の例: 100文字以上のランダム英数字（"AAAAAAAA..." で始まる）
X_BEARER_TOKEN=paste_your_bearer_token_here

# --- Discord Webhook ---
# 取得元: Discord サーバー設定 → 連携サービス → Webhook → 新しい Webhook
# 形状の例: https://discord.com/api/webhooks/<19桁ID>/<70文字程度のトークン>
DISCORD_WEBHOOK=your_discord_webhook_url_here

# --- Anthropic Claude API ---
# 取得元: https://console.anthropic.com → API Keys → Create Key
# 形状の例: sk-ant-api03-<長いランダム文字列>
ANTHROPIC_API_KEY=your_anthropic_api_key_here
